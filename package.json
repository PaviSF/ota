{
  "name": "@pavisf/ota",
  "version": "1.0.0",
  "description": "Interactive terminal app for pushing EAS OTA updates to saved channels and versions",
  "type": "module",
  "bin": {
    "ota": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "tsup"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PaviSF/ota.git"
  },
  "license": "MIT",
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "ink": "^5.2.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
